{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Compile & Run C++",
        "type": "shell",
        "command": "g++",
        "args": [
          "-std=c++17",
          "-O2",
          "-Wall",
          "-Wextra",
          "-pedantic",
          "${file}",
          "-o",
          "${fileDirname}\\${fileBasenameNoExtension}.exe",
          "&&",
          "${fileDirname}\\${fileBasenameNoExtension}.exe"
        ],
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always" }
      }
    ]
  }